{
  "$name": "Casa en Orden · 2b Jardín de cempasúchil",
  "font": {
    "display": "'Young Serif', Georgia, 'Times New Roman', serif",
    "body": "'Instrument Sans', system-ui, -apple-system, 'Segoe UI', sans-serif"
  },
  "text": {
    "display-xl": { "family": "display", "size": 38, "lineHeight": 1.05, "weight": 400 },
    "display-l":  { "family": "display", "size": 30, "lineHeight": 1.1,  "weight": 400 },
    "display-m":  { "family": "display", "size": 24, "lineHeight": 1.15, "weight": 400 },
    "display-s":  { "family": "display", "size": 20, "lineHeight": 1.2,  "weight": 400 },
    "item":       { "family": "body", "size": 17, "lineHeight": 1.3,  "weight": 500 },
    "body":       { "family": "body", "size": 16, "lineHeight": 1.4,  "weight": 400 },
    "body-strong":{ "family": "body", "size": 16, "lineHeight": 1.35, "weight": 600 },
    "small":      { "family": "body", "size": 14, "lineHeight": 1.4,  "weight": 400 },
    "meta":       { "family": "body", "size": 13, "lineHeight": 1.35, "weight": 400 },
    "eyebrow":    { "family": "body", "size": 12, "lineHeight": 1.3,  "weight": 700, "letterSpacing": "0.08em", "transform": "uppercase" },
    "nav":        { "family": "body", "size": 11, "lineHeight": 1.2,  "weight": 500, "weightActive": 700 }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "gutter": 16, "rowMin": 54, "tap": 44, "contentMax": 720 },
  "radius": { "xs": 8, "sm": 12, "base": 18, "lg": 22, "pill": 999 },
  "elevation": {
    "light": { "sheet": "0 -8px 32px rgba(19,37,28,.18)", "toast": "0 8px 24px rgba(19,37,28,.22)", "scrim": "rgba(12,25,20,.45)" },
    "dark":  { "sheet": "0 -8px 32px rgba(0,0,0,.5)", "toast": "0 8px 24px rgba(0,0,0,.5)", "scrim": "rgba(0,0,0,.6)" }
  },
  "motion": { "fast": 120, "base": 200, "sheet": 280, "toastHold": 4000, "easeOut": "cubic-bezier(.2,.8,.2,1)", "easeIn": "cubic-bezier(.4,0,1,1)" },
  "color": {
    "light": {
      "bg": "#F1F5F1", "surface": "#FFFFFF", "tint": "#E8EFE9",
      "ink": "#13251C", "muted": "#4A5E54", "line": "#D4E0D7",
      "accent": "#1E6B4A", "accent-ink": "#FFFFFF", "accent-soft": "#DCEEE3",
      "sun": "#F2A23A", "sun-ink": "#13251C", "sun-soft": "#FCE2B0",
      "warn": "#8A5300", "warn-soft": "#FBEACB",
      "danger": "#B3261E", "danger-soft": "#FBE4E1",
      "info": "#2C5DA8", "info-soft": "#E0E9F7",
      "ok": "#1F7046", "ok-soft": "#DDF0E4",
      "focus": "#1E6B4A",
      "person-a": "#2B62C4", "person-a-soft": "#E1EAFA",
      "person-b": "#B8401F", "person-b-soft": "#F8E2DA",
      "person-both": "#13251C"
    },
    "dark": {
      "bg": "#0C1914", "surface": "#132620", "tint": "#1A3128",
      "ink": "#EEF2EA", "muted": "#A7BAAF", "line": "#263E33",
      "accent": "#7FD3A8", "accent-ink": "#0C1914", "accent-soft": "#1D3D2F",
      "sun": "#F5AE45", "sun-ink": "#1A1205", "sun-soft": "#3A2C12",
      "warn": "#F0C066", "warn-soft": "#352A12",
      "danger": "#FF9C92", "danger-soft": "#3B1C1A",
      "info": "#9DBDF5", "info-soft": "#1C2A44",
      "ok": "#86D6A5", "ok-soft": "#173826",
      "focus": "#7FD3A8",
      "person-a": "#82AEFF", "person-a-soft": "#1C2B47",
      "person-b": "#FF8F6E", "person-b-soft": "#40221A",
      "person-both": "#EEF2EA"
    }
  },
  "personPalette": [
    { "id": "azul",    "group": "frio",   "light": "#2B62C4", "lightSoft": "#E1EAFA", "dark": "#82AEFF", "darkSoft": "#1C2B47" },
    { "id": "ciruela", "group": "frio",   "light": "#7A3A9E", "lightSoft": "#EFE2F6", "dark": "#D3A2F2", "darkSoft": "#2E1F3A" },
    { "id": "jade",    "group": "frio",   "light": "#0E7368", "lightSoft": "#D8EFEC", "dark": "#5FD3C3", "darkSoft": "#123532" },
    { "id": "teja",    "group": "calido", "light": "#B8401F", "lightSoft": "#F8E2DA", "dark": "#FF8F6E", "darkSoft": "#40221A" },
    { "id": "ocre",    "group": "calido", "light": "#8A5D00", "lightSoft": "#F6E8C6", "dark": "#EBC35C", "darkSoft": "#352A10" },
    { "id": "rosa",    "group": "calido", "light": "#B0306A", "lightSoft": "#F8DEEA", "dark": "#FF8DBC", "darkSoft": "#42192B" }
  ],
  "personDefaults": { "a": "azul", "b": "teja", "rule": "Una persona de grupo frío y otra de grupo cálido. 'Ambos' = punto partido a/b." },
  "entryShapes": { "evento": "círculo", "pendiente": "cuadrado redondeado", "fecha": "rombo", "ninos": "triángulo", "plan": "anillo", "comida": "píldora horizontal" }
}
