# Copia este archivo a .env.local y llena los valores de tu proyecto de Supabase
# (Project Settings → API). Nunca subas .env.local al repositorio.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Opcional (fase 2): nombre de usuario del bot de Telegram, sin @. Activa el botón "Abrir Telegram".
VITE_TELEGRAM_BOT=
